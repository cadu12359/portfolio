@page "/architecture"
@inject LanguageService Lang
@implements IDisposable

<PageTitle>@T("Arquitetura do portfólio", "Portfolio architecture") | Carlos Eduardo</PageTitle>

<article class="architecture-page">
    <header class="architecture-intro">
        <a class="back-link" href="./"><span aria-hidden="true">←</span> @T("Voltar ao portfólio", "Back to portfolio")</a>
        <p class="eyebrow">@T("POR DENTRO DO PROJETO", "INSIDE THE PROJECT")</p>
        <h1>@T("Arquitetura & decisões", "Architecture & decisions")<span class="title-dot">.</span></h1>
        <p class="intro-description">@T("Da interface à infraestrutura: como este portfólio é organizado, onde cada parte executa e quais escolhas sustentam a implementação.", "From interface to infrastructure: how this portfolio is organized, where each part runs, and the choices behind its implementation.")</p>
        <a class="source-link" href="https://github.com/cadu12359/portfolio" target="_blank" rel="noopener noreferrer">@T("Explorar repositório", "Explore repository") <span aria-hidden="true">↗</span></a>
    </header>

    <section class="architecture-section" aria-labelledby="system-heading">
        <div class="section-heading">
            <h2 id="system-heading">@T("Visão do sistema", "System overview")</h2>
            <span class="section-note">@T("TOPOLOGIA DE IMPLANTAÇÃO", "DEPLOYMENT TOPOLOGY")</span>
        </div>
        <figure class="system-map" aria-labelledby="system-heading" aria-describedby="system-caption">
            <div class="map-heading">
                <span class="map-label">@T("INTERFACE → SERVIÇOS → DADOS", "INTERFACE → SERVICES → DATA")</span>
                <span class="map-caption">@T("Frontend estático · backend em contêineres", "Static frontend · containerized backend")</span>
            </div>
            <div class="deployment-flow">
                <div class="deployment-zone client-zone">
                    <div class="zone-heading"><span>01</span> @T("DISTRIBUIÇÃO & CLIENTE", "DELIVERY & CLIENT")</div>
                    <div class="system-node delivery-node">
                        <span class="node-kind">@T("HOSPEDAGEM ESTÁTICA", "STATIC HOSTING")</span>
                        <h3>GitHub Pages</h3>
                        <p>@T("Distribui os arquivos da aplicação.", "Serves the application files.")</p>
                    </div>
                    <div class="vertical-connection"><span aria-hidden="true">↓</span> @T("HTTPS · download da aplicação", "HTTPS · application download")</div>
                    <div class="system-node browser-node">
                        <span class="node-kind">@T("EXECUÇÃO NO NAVEGADOR", "RUNS IN THE BROWSER")</span>
                        <h3>Blazor WebAssembly</h3>
                        <p>@T("Renderiza a interface e consulta a API.", "Renders the interface and calls the API.")</p>
                        <span class="node-detail">C# <span aria-hidden="true">/</span> .NET 9 <span aria-hidden="true">/</span> PT + EN</span>
                    </div>
                </div>
                <div class="horizontal-connection">
                    <span>HTTPS</span>
                    <span class="connection-line" aria-hidden="true">→</span>
                    <span>REST / JSON</span>
                </div>
                <div class="deployment-zone cloud-zone">
                    <div class="zone-heading"><span>02</span> ORACLE CLOUD <span class="zone-meta">VPS</span></div>
                    <div class="system-node proxy-node">
                        <span class="node-kind">@T("ENTRADA HTTPS", "HTTPS ENTRY POINT")</span>
                        <h3>Caddy <span class="inline-detail">reverse proxy</span></h3>
                    </div>
                    <div class="vertical-connection"><span aria-hidden="true">↓</span> HTTP</div>
                    <div class="container-boundary">
                        <span class="boundary-label">Docker Compose</span>
                        <div class="system-node api-node">
                            <span class="node-kind">@T("APLICAÇÃO", "APPLICATION")</span>
                            <h3>ASP.NET Core API</h3>
                            <p>@T("Endpoints e serviços de aplicação.", "Endpoints and application services.")</p>
                        </div>
                        <div class="vertical-connection"><span aria-hidden="true">↓</span> EF Core / Npgsql</div>
                        <div class="system-node database-node">
                            <span class="node-kind">@T("PERSISTÊNCIA", "PERSISTENCE")</span>
                            <h3>PostgreSQL</h3>
                            <p>@T("Conteúdo do portfólio · volume persistente.", "Portfolio content · persistent volume.")</p>
                        </div>
                    </div>
                </div>
            </div>
            <figcaption id="system-caption">@T("O navegador recebe a aplicação do GitHub Pages e consulta a API via Caddy. A API acessa o PostgreSQL pela rede interna do Docker; o banco não publica uma porta externa no Compose de produção.", "The browser loads the application from GitHub Pages and calls the API through Caddy. The API accesses PostgreSQL over Docker's internal network; the production Compose configuration does not publish a database port.")</figcaption>
        </figure>
        <div class="delivery-strip">
            <span class="delivery-label">GitHub Actions</span>
            <p>@T("Alterações em main acionam os fluxos de publicação: frontend no GitHub Pages; backend na VPS via SSH e Docker Compose.", "Changes to main trigger the deployment workflows: frontend to GitHub Pages; backend to the VPS through SSH and Docker Compose.")</p>
        </div>
    </section>

    <section class="architecture-section" aria-labelledby="structure-heading">
        <div class="section-heading">
            <h2 id="structure-heading">@T("Organização do backend", "Backend structure")</h2>
            <span class="section-note">CLEAN ARCHITECTURE</span>
        </div>
        <p class="section-description">@T("Um backend organizado em projetos com responsabilidades distintas. O domínio não referencia infraestrutura; os repositórios implementam contratos definidos no núcleo.", "One backend organized into projects with distinct responsibilities. The domain does not reference infrastructure; repositories implement contracts defined in the core.")</p>
        <div class="responsibility-list">
            <div class="responsibility-row">
                <h3><span class="layer-marker" aria-hidden="true"></span>API</h3>
                <p>@T("Recebe as requisições HTTP, configura os serviços e expõe os endpoints.", "Receives HTTP requests, configures services, and exposes endpoints.")</p>
            </div>
            <div class="responsibility-row">
                <h3><span class="layer-marker" aria-hidden="true"></span>Application</h3>
                <p>@T("Coordena os serviços e transforma o conteúdo em DTOs no idioma solicitado.", "Coordinates services and maps content to DTOs in the requested language.")</p>
            </div>
            <div class="responsibility-row">
                <h3><span class="layer-marker domain-marker" aria-hidden="true"></span>Domain</h3>
                <p>@T("Define as entidades e os contratos de repositório, sem dependências de frameworks.", "Defines entities and repository contracts, without framework dependencies.")</p>
            </div>
            <div class="responsibility-row">
                <h3><span class="layer-marker" aria-hidden="true"></span>Infrastructure</h3>
                <p>@T("Implementa os repositórios e o acesso ao PostgreSQL com Entity Framework Core.", "Implements repositories and PostgreSQL access with Entity Framework Core.")</p>
            </div>
        </div>
    </section>

    <section class="architecture-section" aria-labelledby="decisions-heading">
        <div class="section-heading">
            <h2 id="decisions-heading">@T("Decisões de arquitetura", "Architecture decisions")</h2>
            <span class="section-note">@T("CONTEXTO DAS DECISÕES", "DECISION CONTEXT")</span>
        </div>
        <div class="decision-list">
            <div class="decision-row">
                <span class="decision-index" aria-hidden="true">01</span>
                <div><h3>@T("C# do cliente ao servidor", "C# from client to server")</h3><p>@T("Blazor integra interface e backend no ecossistema .NET. Uma linguagem comum traz consistência ao desenvolvimento e facilita a manutenção da aplicação.", "Blazor brings the interface and backend together in the .NET ecosystem. A shared language brings consistency to development and simplifies application maintenance.")</p></div>
            </div>
            <div class="decision-row">
                <span class="decision-index" aria-hidden="true">02</span>
                <div><h3>@T("Conteúdo servido por API", "API-driven content")</h3><p>@T("Experiências, habilidades e formação ficam centralizadas no PostgreSQL e são disponibilizadas pela API. Essa organização separa conteúdo e apresentação, permitindo atualizar os dados sem recompilar a interface.", "Experience, skills, and education are centralized in PostgreSQL and served through the API. This structure separates content from presentation, allowing data updates without rebuilding the interface.")</p></div>
            </div>
            <div class="decision-row">
                <span class="decision-index" aria-hidden="true">03</span>
                <div><h3>@T("Infraestrutura com Docker", "Docker-based infrastructure")</h3><p>@T("API e banco executam em contêineres na Oracle Cloud, com serviços e persistência definidos no Docker Compose. A integração com GitHub Actions automatiza a publicação e mantém a operação organizada.", "The API and database run in containers on Oracle Cloud, with services and persistence defined in Docker Compose. GitHub Actions integration automates deployment and keeps operations organized.")</p></div>
            </div>
        </div>
    </section>

    <section class="architecture-section visual-system" aria-labelledby="visual-heading">
        <div class="section-heading">
            <h2 id="visual-heading">@T("Sistema visual", "Visual system")</h2>
            <span class="section-note">@T("BASE DA INTERFACE", "INTERFACE FOUNDATIONS")</span>
        </div>
        <div class="visual-foundations">
            <div class="visual-foundation">
                <span class="foundation-label">@T("TIPOGRAFIA", "TYPOGRAPHY")</span>
                <span class="type-specimen" aria-hidden="true">Aa<span>0123</span></span>
                <h3>Fira Code</h3>
                <p>@T("Tipografia monoespaçada como identidade do portfólio.", "Monospaced typography as the portfolio's visual identity.")</p>
            </div>
            <div class="visual-foundation">
                <span class="foundation-label">@T("PALETA", "PALETTE")</span>
                <div class="palette-swatches" aria-hidden="true"><span class="swatch-ink"></span><span class="swatch-teal"></span><span class="swatch-pink"></span><span class="swatch-amber"></span></div>
                <h3>@T("Neutros + acentos", "Neutrals + accents")</h3>
                <p>@T("Grafite, teal, rosa e âmbar definidos em variáveis CSS compartilhadas.", "Graphite, teal, pink, and amber defined through shared CSS variables.")</p>
            </div>
            <div class="visual-foundation">
                <span class="foundation-label">@T("COMPOSIÇÃO", "COMPOSITION")</span>
                <div class="component-specimen" aria-hidden="true"><span></span><span></span><span></span></div>
                <h3>@T("Componentes Blazor", "Blazor components")</h3>
                <p>@T("Cards, badges e seletor de idioma reutilizados entre as páginas.", "Cards, badges, and a language switcher reused across pages.")</p>
            </div>
        </div>
    </section>
    <footer class="architecture-footer">
        <span>@T("A implementação completa está no repositório.", "The full implementation is in the repository.")</span>
        <a class="source-link" href="https://github.com/cadu12359/portfolio" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
    </footer>
</article>

@code {
    private string T(string pt, string en) => Lang.Current == "pt" ? pt : en;

    protected override void OnInitialized() => Lang.OnLanguageChanged += OnLanguageChanged;

    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Lang.OnLanguageChanged -= OnLanguageChanged;
}
